{% assign detail = null %}
{% assign project = null %}
{% assign lang = page.lang | default: 'en' %}
{% assign t = site.data.portfolio[lang] %}
{% assign home = '/' -%}
{%- if lang == 'ko' %}{% assign home = '/ko/' %}{% endif %}
{% assign english_path = '/' %}
{% if page.kind == 'projects' %}{% assign english_path = '/projects/' %}{% endif %}
{% if page.kind == 'cv' %}{% assign english_path = '/cv/' %}{% endif %}
{% if page.kind == 'detail' %}{% assign english_path = '/detail/' %}{% endif %}
{% if page.kind == 'project' %}
  {% assign project = site.data.portfolio.projects | where: 'id', page.project_id | first %}
  {% assign detail = project[lang] %}
  {% assign english_path = '/projects/' | append: project.id | append: '/' %}
{% endif %}
{% assign korean_path = '/ko' | append: english_path %}
<!doctype html>
<html lang="{{ lang }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>
      {% if detail %}{{ detail.title }} — {% endif %}
      {{ t.title }}
    </title>
    <meta name="description" content="{% if detail %}{{ detail.summary | escape }}{% else %}{{ t.description | escape }}{% endif %}">
    <meta name="theme-color" content="#ffffff">
    <link rel="canonical" href="{{ page.url | absolute_url }}">
    <link rel="alternate" hreflang="en" href="{{ english_path | absolute_url }}">
    <link rel="alternate" hreflang="ko" href="{{ korean_path | absolute_url }}">
    <link rel="alternate" hreflang="x-default" href="{{ english_path | absolute_url }}">
    <meta property="og:type" content="website">
    <meta property="og:title" content="{% if detail %}{{ detail.title | escape }} — {% endif %}{{ t.title | escape }}">
    <meta property="og:description" content="{% if detail %}{{ detail.summary | escape }}{% else %}{{ t.description | escape }}{% endif %}">
    <meta property="og:url" content="{{ page.url | absolute_url }}">
    <meta property="og:image" content="{{ '/assets/img/jaewon-cho.jpg' | absolute_url }}">
    <meta property="og:locale" content="{% if lang == 'ko' %}ko_KR{% else %}en_US{% endif %}">
    <link rel="icon" href="{{ '/assets/img/portfolio-mark.svg' | relative_url }}" type="image/svg+xml">
    <link rel="stylesheet" href="{{ '/assets/css/portfolio.css' | relative_url }}">
    <script src="{{ '/assets/js/portfolio.js' | relative_url }}" defer></script>
  </head>
  <body>
    <a class="skip-link" href="#main">{{ t.skip }}</a>
    <header class="site-header wrap">
      <a class="brand" href="{{ home | relative_url }}">Jaewon Cho</a>
      <nav aria-label="{% if lang == 'ko' %}주 메뉴{% else %}Main navigation{% endif %}">
        <a href="{{ home | relative_url }}#about">{{ t.nav_about }}</a>
        <a href="{{ home | relative_url }}#journey">{{ t.nav_journey }}</a>
        <a href="{{ home | relative_url }}#work">{{ t.nav_work }}</a>
        <a
          href="{{ home | append: 'detail/' | relative_url }}"
          {% if page.kind == 'detail' %}
            aria-current="page"
          {% endif %}
        >
          {{- t.nav_detail -}}
        </a>
      </nav>
      <div class="language-switch" aria-label="{% if lang == 'ko' %}언어 선택{% else %}Language{% endif %}">
        <a
          href="{{ english_path | relative_url }}"
          lang="en"
          hreflang="en"
          {% if lang == 'en' %}
            aria-current="page"
          {% endif %}
          >EN</a
        >
        <span aria-hidden="true">/</span>
        <a
          href="{{ korean_path | relative_url }}"
          lang="ko"
          hreflang="ko"
          {% if lang == 'ko' %}
            aria-current="page"
          {% endif %}
          >한국어</a
        >
      </div>
    </header>
    <main id="main" class="wrap document">
      {% if page.kind == 'detail' %}
        <section class="personal-detail" aria-labelledby="detail-title">
          <h1 id="detail-title">{{ t.detail_title }}</h1>
          <div class="detail-profile">
            <img class="detail-portrait" src="{{ '/assets/img/jaewon-cho.jpg' | relative_url }}" alt="{{ t.portrait }}" width="2250" height="2893">
            <div class="detail-profile-copy">
              <h2 class="detail-name">{{ t.detail_name }}</h2>
              <p class="alternate-name">{{ t.detail_korean_name }}</p>
              <p class="subtitle">Data · AI · Engineering</p>
              <h3>{{ t.detail_hobbies_title }}</h3>
              <ul class="hobbies-list">
                {% for hobby in t.detail_hobbies %}
                  <li>{{ hobby }}</li>
                {% endfor %}
              </ul>
            </div>
          </div>
          <h2>{{ t.detail_bio_title }}</h2>
          <dl class="interests-list">
            {% for entry in t.detail_bio %}
              <div>
                <dt>{{ entry.label }}</dt>
                <dd>{{ entry.body }}</dd>
              </div>
            {% endfor %}
          </dl>
          <h2>{{ t.detail_photos_title }}</h2>
          <div class="detail-gallery">
            {% for photo in t.detail_photos %}
              <img src="{{ '/assets/img/' | append: photo.file | relative_url }}" alt="{{ photo.alt | escape }}" loading="lazy">
            {% endfor %}
          </div>
        </section>
      {% endif %}

      {% if page.kind == 'home' %}
        <section id="about" aria-labelledby="profile-title">
          <div class="profile-heading">
            <div>
              <h1 id="profile-title">Jaewon Cho</h1>
              <p class="subtitle">Data · AI · Engineering</p>
            </div>
            <img class="profile-photo" src="{{ '/assets/img/jaewon-cho.jpg' | relative_url }}" alt="{{ t.portrait }}" width="100" height="112">
          </div>
          <div class="biography">
            {% for paragraph in t.bio %}
              <p>{{ paragraph }}</p>
            {% endfor %}
          </div>
        </section>
      {% endif %}
      {% if page.kind == 'home' or page.kind == 'cv' %}
        <section id="journey" aria-labelledby="journey-title">
          <{% if page.kind == 'cv' %}h1{% else %}h2{% endif %} id="journey-title">
            {{- t.journey_title -}}
          </{% if page.kind == 'cv' %}h1{% else %}h2{% endif %}>
          <table class="journey-table">
            <thead>
              <tr>
                <th scope="col">{{ t.date_label }}</th>
                <th scope="col">{{ t.highlight_label }}</th>
              </tr>
            </thead>
            <tbody>
              {% for item in t.journey %}
                <tr>
                  <th scope="row">{{ item.date }}</th>
                  <td>{{ item.text }}</td>
                </tr>
              {% endfor %}
            </tbody>
          </table>
        </section>
      {% endif %}
      {% if page.kind == 'home' %}
        <section id="interests" aria-labelledby="interests-title">
          <h2 id="interests-title">{{ t.interests_title }}</h2>
          <dl class="interests-list">
            {% for item in t.interests %}
              <div>
                <dt>{{ item.title }}</dt>
                <dd>{{ item.body }}</dd>
              </div>
            {% endfor %}
          </dl>
        </section>
      {% endif %}
      {% if page.kind == 'home' or page.kind == 'projects' %}
        <section id="work" aria-labelledby="work-title">
          <{% if page.kind == 'projects' %}h1{% else %}h2{% endif %} id="work-title">
            {%- if page.kind == 'home' %}{{ t.selected }}{% else %}{{ t.project_page_title }}{% endif -%}
          </{% if page.kind == 'projects' %}h1{% else %}h2{% endif %}>
          <p class="section-intro">{{ t.work_intro }}</p>
          <div class="filters" hidden aria-label="{% if lang == 'ko' %}프로젝트 필터{% else %}Project filters{% endif %}">
            <button type="button" data-filter="all" aria-pressed="true">{{ t.all }}</button
            ><button type="button" data-filter="research" aria-pressed="false">{{ t.research }}</button
            ><button type="button" data-filter="personal" aria-pressed="false">{{ t.personal }}</button>
          </div>
          <p id="filter-status" class="sr-only" role="status" aria-live="polite"></p>
          <div class="project-list">
            {% for project in site.data.portfolio.projects -%}
              {%- assign item = project[lang] %}
              <article class="project-card" data-category="{{ project.category }}">
                <h3>
                  <a href="{{ home | append: 'projects/' | append: project.id | append: '/' | relative_url }}">{{ item.title }}</a>
                </h3>
                <p>{{ item.summary }}</p>
                <p class="project-meta">
                  {{ item.badge }}
                  <span aria-hidden="true">·</span> {{ project.tags | join: ', ' }}
                </p>
              </article>
            {% endfor %}
          </div>
        </section>
      {% endif %}
      {% if page.kind == 'project' %}
        <article class="project-detail">
          <a class="text-link back-link" href="{{ home | append: 'projects/' | relative_url }}">← {{ t.back }}</a>
          <p class="eyebrow">{{ detail.subtitle }}</p>
          <h1>{{ detail.title }}</h1>
          <p class="detail-intro">{{ detail.summary }}</p>
          <div class="tags">
            {% for tag in project.tags -%}
              <span>{{ tag }}</span>
            {%- endfor %}
          </div>
          <img class="detail-image" src="{{ '/assets/img/' | append: project.image | relative_url }}" alt="{{ detail.title }}" loading="lazy">
          <div class="detail-body">
            <aside>
              <p class="eyebrow">{{ t.overview }}</p>
              <p class="project-badge">{{ detail.badge }}</p>
            </aside>
            <div>
              <p class="overview">{{ detail.overview }}</p>
              <h2>{{ t.approach }}</h2>
              {% for section in detail.sections %}
                <section>
                  <h3>{{ section.title }}</h3>
                  <p>{{ section.body }}</p>
                </section>
              {% endfor %}
              {% if project.links.size > 0 %}
                <h2>{{ t.resources }}</h2>
                <ul class="resource-list">
                  {% for link in project.links %}
                    <li>
                      <a
                        class="text-link"
                        href="{% if link.url contains 'https://' %}{{ link.url }}{% else %}{{ link.url | relative_url }}{% endif %}"
                      >
                        {{- link[lang] }} ↗</a
                      >
                    </li>
                  {% endfor %}
                </ul>
              {% endif %}
              {% if lang == 'en' %}
                <details class="archive-content">
                  <summary>{{ t.original }}</summary>
                  {{ content }}
                </details>
              {% else -%}
                <a class="text-link" href="{{ english_path | relative_url }}">{{ t.original }} ↗</a>
              {%- endif %}
            </div>
          </div>
        </article>
      {% endif %}
      <section id="contact" aria-labelledby="contact-title">
        <h2 id="contact-title">{{ t.contact_title }}</h2>
        <ul class="contact-links">
          <li><a href="mailto:{{ site.email }}">Email</a></li>
          <li><a href="https://github.com/Jaejae1107">GitHub</a></li>
          <li><a href="https://www.linkedin.com/in/{{ site.linkedin_username }}">LinkedIn</a></li>
        </ul>
      </section>
    </main>
    <footer class="wrap site-footer">© {{ site.time | date: '%Y' }} Jaewon Cho</footer>
  </body>
</html>
